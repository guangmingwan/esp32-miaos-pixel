#include <stdint.h>
#include <string.h>

#include <esp_err.h>
#include <esp_log.h>
#include <esp_ota_ops.h>
#include <esp_partition.h>
#include <esp_rom_crc.h>
#include <esp_system.h>
#include <freertos/FreeRTOS.h>
#include <freertos/task.h>

extern int @MIA_EMULATOR_ENTRY@(int argc, char *argv[]);
extern esp_err_t host_platform_init(void);

static const char *TAG = "@MIA_EMULATOR_APP@_app";

typedef enum {
    MIA_LAUNCHER_SWITCH_OK = 0,
    MIA_LAUNCHER_SWITCH_ERR_PARTITION,
    MIA_LAUNCHER_SWITCH_ERR_ERASE,
    MIA_LAUNCHER_SWITCH_ERR_WRITE_PRIMARY,
    MIA_LAUNCHER_SWITCH_ERR_WRITE_MIRROR,
} MiaLauncherSwitchCode;

typedef struct {
    MiaLauncherSwitchCode code;
    const char *stage;
    esp_err_t error;
} MiaLauncherSwitchResult;

typedef struct __attribute__((packed)) {
    uint32_t ota_seq;
    uint8_t seq_label[20];
    uint32_t ota_state;
    uint32_t crc;
} MiaOtaEntry;

static void set_entry(MiaOtaEntry *entry, uint32_t seq, uint32_t state) {
    memset(entry, 0, sizeof(MiaOtaEntry));
    entry->ota_seq = seq;
    entry->ota_state = state;
    entry->crc = esp_rom_crc32_le(UINT32_MAX, (uint8_t *)&entry->ota_seq, 4);
}

static MiaLauncherSwitchResult launcher_switch_ok(void) {
    return (MiaLauncherSwitchResult){MIA_LAUNCHER_SWITCH_OK, "complete", ESP_OK};
}

static MiaLauncherSwitchResult launcher_switch_error(MiaLauncherSwitchCode code, const char *stage, esp_err_t error) {
    return (MiaLauncherSwitchResult){code, stage, error};
}

static MiaLauncherSwitchResult switch_to_launcher(void) {
    const esp_partition_t *otap = esp_partition_find_first(
        ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_OTA, NULL);
    if (otap == NULL) {
        return launcher_switch_error(MIA_LAUNCHER_SWITCH_ERR_PARTITION, "find otadata partition", ESP_ERR_NOT_FOUND);
    }

    MiaOtaEntry entries[2];
    set_entry(&entries[0], 1, ESP_OTA_IMG_VALID);
    set_entry(&entries[1], 3, ESP_OTA_IMG_VALID);

    esp_err_t err = esp_partition_erase_range(otap, 0, otap->size);
    if (err != ESP_OK) {
        return launcher_switch_error(MIA_LAUNCHER_SWITCH_ERR_ERASE, "erase otadata", err);
    }
    err = esp_partition_write(otap, 0, &entries[0], sizeof(MiaOtaEntry));
    if (err != ESP_OK) {
        return launcher_switch_error(MIA_LAUNCHER_SWITCH_ERR_WRITE_PRIMARY, "write primary seq=1", err);
    }
    err = esp_partition_write(otap, 4096, &entries[1], sizeof(MiaOtaEntry));
    if (err != ESP_OK) {
        return launcher_switch_error(MIA_LAUNCHER_SWITCH_ERR_WRITE_MIRROR, "write mirror seq=3", err);
    }
    return launcher_switch_ok();
}

static void hold_after_launcher_switch_failure(void) {
    while (1) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

static void emulator_task(void *arg) {
    char *argv[] = {"@MIA_EMULATOR_APP@"};
    (void)arg;

    (void)@MIA_EMULATOR_ENTRY@(1, argv);
    const MiaLauncherSwitchResult switch_result = switch_to_launcher();
    if (switch_result.code == MIA_LAUNCHER_SWITCH_OK) {
        esp_restart();
    }
    ESP_LOGE(TAG, "launcher return failed at %s: %s", switch_result.stage, esp_err_to_name(switch_result.error));
    hold_after_launcher_switch_failure();

    while (1) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

void app_main(void) {
    ESP_ERROR_CHECK(host_platform_init());
    xTaskCreatePinnedToCore(emulator_task, "@MIA_EMULATOR_APP@_emu", @MIA_EMULATOR_STACK@, NULL, 5, NULL, 1);
}
